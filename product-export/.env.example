# ---------- MongoDB ----------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGO_DB_NAME=<database-name>
# Collection the pipeline runs on (the one holding status / variants / sellerId)
MONGO_COLLECTION=products

# ---------- Query ----------
# Which report to run: the file name in queries/ without .js
# (active-products = one row per product variant; see queries/example.js to write your own)
QUERY=active-products

# ---------- Export ----------
# csv | xlsx | both
EXPORT_FORMAT=xlsx
EXPORT_DIR=./exports
# File name prefix (default: the QUERY name); the date/time is appended, e.g. product-export_2026-11-04_1130.xlsx
EXPORT_FILE_PREFIX=product-export
# Product status for the active-products query (its first $match)
EXPORT_STATUS=active
# Variants with less available stock than this (quantity minus active reservations) count as low stock
LOW_STOCK_THRESHOLD=5

# ---------- Delivery ----------
# email | slack | both
DELIVERY=slack

# ---------- Slack ----------
# Bot token of a Slack app with scopes: files:write, chat:write, im:write
SLACK_BOT_TOKEN=<xoxb-...>
# Comma-separated channel IDs (e.g. C0123456789). Invite the bot to each channel first: /invite @YourBot
SLACK_CHANNEL_ID=
# Comma-separated user IDs (e.g. U0123456789) to receive the file as a direct message
SLACK_USER_ID=
# true = after posting, delete this report's earlier posts (only the bot's own posts with this
# report's files), so only the latest report stays. DMs need the extra scope im:history.
SLACK_DELETE_PREVIOUS=true

# ---------- Meta (Facebook/Instagram ads, read-only) ----------
# System user token with only the ads_read permission. Leave empty to run without Meta.
META_ACCESS_TOKEN=
# Comma-separated ad account IDs, e.g. act_1234567890 (Ads Manager URL: act=...)
META_AD_ACCOUNT_ID=
# Optional: Graph API version
META_API_VERSION=v23.0
# Optional: file mapping campaigns to sellers when the shop name is not in the campaign name
META_MAPPING_FILE=meta-campaign-sellers.json

# ---------- Email (SMTP, only for DELIVERY=email or both) ----------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# true for port 465, false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>

MAIL_FROM="Naar Reports <reports@naar.io>"
# Comma-separated lists
MAIL_TO=<recipient@naar.io>
MAIL_CC=
MAIL_SUBJECT=Naar Active Products Export

# ---------- Run options ----------
# true = build the file(s) but do not send anything
DRY_RUN=false
# Delete the local file(s) after a successful send
DELETE_AFTER_SEND=false
