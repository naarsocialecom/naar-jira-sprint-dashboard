# Copy to backend/.env and fill in. backend/.env is gitignored.
# Keep comments on their own lines: systemd's EnvironmentFile does not
# understand inline "# ..." comments after a value.
# Values marked (required) must be set or the app refuses to start.

# ── App ─────────────────────────────────────────────────────
# development | production
APP_ENV=production
DEBUG=false
PORT=5005
# (required) generate with: python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# ── Jira ────────────────────────────────────────────────────
# (required)
JIRA_DOMAIN=https://your-site.atlassian.net
# (required)
JIRA_EMAIL=
# (required) id.atlassian.com → Security → API tokens
JIRA_API_TOKEN=
JIRA_TIMEOUT_SECONDS=30

# ── Sprint dashboard ────────────────────────────────────────
# (required)
JIRA_BOARD_ID=4
# (required)
JIRA_PROJECT_KEY=NAAR
EPIC_TABLE_PAGE_SIZE=10
JIRA_FIELD_PLATFORM=customfield_10054
JIRA_FIELD_HIGHLIGHTS=customfield_11550
JIRA_HIGHLIGHTS_TICKET=NAAR-2531

# ── Naar Data / Operations page (/ndo) ──────────────────────
NDO_PROJECT_KEY=NDO
NDO_ISSUE_TYPES=Incident,Operations
NDO_EXCLUDED_STATUSES=Done,Rejected
# Jira "Severity" field (Sev-0 … Sev-3)
JIRA_FIELD_SEVERITY=customfield_10048
# Flag tickets with no update for this many days
NDO_STALE_DAYS=14
# How long Jira results are cached per worker (seconds)
NDO_CACHE_SECONDS=120
# Decides what "today" means for team updates and the daily post
REPORT_TIMEZONE=Asia/Kolkata
# Public URL of this dashboard, linked from the Slack message
DASHBOARD_URL=https://dashboard.example.com

# ── Slack (optional) ────────────────────────────────────────
# Bot token scopes: chat:write, files:write, channels:history, users:read
# (+ groups:history for private channels). Invite the bot to every channel below.
SLACK_BOT_TOKEN=
# Channel the 7 PM summary is posted to (channel ID, not the name)
SLACK_CHANNEL_ID=
# Channel developers post their updates in
SLACK_DEV_UPDATES_CHANNEL_ID=
# Channel for the 6 PM "1 hour left" reminder (blank = developer updates channel)
SLACK_REMINDER_CHANNEL_ID=
# Who to ping in the reminder, e.g. <@U0123456789> or <!subteam^S012345>
SLACK_REMINDER_MENTION=
# Shown in the reminder text; the actual schedule is in deploy/ (timers or crontab)
NDO_POST_TIME_LABEL=7:00 PM IST
# Seconds between automatic Slack fetches while the dashboard is open
NDO_DEV_SYNC_SECONDS=300
# Project keys turned into Jira links (blank = NDO_PROJECT_KEY + JIRA_PROJECT_KEY)
TICKET_KEY_PREFIXES=

# ── Slack image (screenshot of /ndo via Playwright) ─────────
# Where the screenshot job reaches the running app (default http://127.0.0.1:PORT)
SNAPSHOT_BASE_URL=
# Blank = Playwright's Chromium (server: python -m playwright install --with-deps chromium)
# "chrome" = use an installed Google Chrome (handy on a Mac)
SNAPSHOT_BROWSER_CHANNEL=
SNAPSHOT_WIDTH=1600

# ── AI rephrasing (optional — original text is used when blank or on error) ──
AI_ENDPOINT_URL=
AI_API_KEY=
# openai_chat: POST {model, messages} → choices[0].message.content
# simple:      POST {system, prompt}  → field named by AI_RESPONSE_FIELD (dot path)
AI_API_FORMAT=openai_chat
AI_MODEL=
# Header carrying the key, and its prefix ("Bearer" → "Authorization: Bearer <key>")
AI_AUTH_HEADER=Authorization
AI_AUTH_PREFIX=Bearer
AI_RESPONSE_FIELD=text
AI_TIMEOUT_SECONDS=30

# ── Storage / logs (optional, default to backend/data and backend/logs) ──
# DATA_DIR=/opt/naar-live/backend/data
# LOG_DIR=/var/log/naar-dashboard
CORS_ORIGINS=https://dashboard.example.com
